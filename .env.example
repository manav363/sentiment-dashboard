# Copy to backend/.env — every variable is optional for local development.

# Upstash Redis (REST) — response cache. Leave empty to run without caching;
# the app logs a warning and /health reports redis_connected=false.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HuggingFace token — only needed for gated models (the default model is public)
HF_TOKEN=

# Backend
BACKEND_PORT=8000

# CORS: JSON array of allowed browser origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
